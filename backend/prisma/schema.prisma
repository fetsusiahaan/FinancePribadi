generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String?  @map("password_hash")
  googleId       String?  @unique @map("google_id")
  // Foto profil sebagai data URI base64 penuh (tanpa kompresi). SENGAJA tidak
  // pernah ikut di toDto()/GET /users/me: isinya bisa belasan MB dan endpoint
  // itu dipanggil tiap cold start lalu di-cache ke AsyncStorage. Dibaca lewat
  // GET /users/me/avatar saja, oleh layar yang benar-benar menampilkannya.
  avatar         String?
  name           String
  phone          String?
  profession     String?
  incomeRange    Decimal? @map("income_range")
  riskProfile    String?  @map("risk_profile")
  preferredCurrency String @default("IDR") @map("preferred_currency")
  financialScore Int      @default(0) @map("financial_score")
  role             UserRole @default(USER)
  twoFactorSecret  String?  @map("two_factor_secret")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  isSuspended      Boolean  @default(false) @map("is_suspended")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  savingsGoals  SavingsGoal[]
  debts         Debt[]
  activityLogs  ActivityLog[]
  refreshTokens RefreshToken[]

  sharedFinancesCreated SharedFinance[]           @relation("SharedFinanceCreator")
  sharedMemberships     SharedFinanceMember[]
  sharedInvitations     SharedFinanceInvitation[] @relation("SharedInvitationCreator")
  sharedTransactions    SharedTransaction[]       @relation("SharedTransactionCreator")
  deviceTokens          DeviceToken[]

  @@map("users")
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @unique
  platform   String   @default("ANDROID")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Category {
  id     String       @id @default(uuid())
  userId String?      @map("user_id")
  name   String
  type   CategoryType
  icon   String?

  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  budgets            Budget[]
  sharedTransactions SharedTransaction[]

  @@map("categories")
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  categoryId  String   @map("category_id")
  amount      Decimal
  date        DateTime @db.Date
  description String?
  receiptUrl  String?  @map("receipt_url")
  isRecurring Boolean  @default(false) @map("is_recurring")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@map("transactions")
}

model Budget {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  categoryId  String   @map("category_id")
  amountLimit Decimal  @map("amount_limit")
  monthYear   DateTime @map("month_year") @db.Date

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@map("budgets")
}

model SavingsGoal {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  name           String
  targetAmount   Decimal   @map("target_amount")
  currentAmount  Decimal   @default(0) @map("current_amount")
  deadline       DateTime? @db.Date
  status         String    @default("ON_TRACK")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("savings_goals")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  module    String
  metadata  Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action])
  @@index([module])
  @@map("activity_logs")
}

model Debt {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  lenderName   String   @map("lender_name")
  totalAmount  Decimal  @map("total_amount")
  remaining    Decimal
  interestRate Decimal? @map("interest_rate")
  dueDate      DateTime? @map("due_date") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("debts")
}

// ---------------------------------------------------------------------------
// Keuangan Bersama (lihat PRD_KB.md)
//
// Sengaja tabel sendiri, TIDAK menumpang `transactions`. Seluruh modul keuangan
// pribadi (dashboard, budget, financial score) membaca `transactions` dengan
// `where: { userId }`; menambahkan kolom "shared" ke sana berarti setiap query
// lama harus ikut menyaringnya dan satu yang terlewat langsung membocorkan uang
// bersama ke total pribadi. Dengan tabel terpisah, modul lama aman tanpa diubah
// satu baris pun.
// ---------------------------------------------------------------------------

model SharedFinance {
  id          String  @id @default(uuid())
  name        String
  description String?
  currency    String  @default("IDR")

  isArchived Boolean   @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")

  createdBy String @map("created_by")

  // Jejak alih kepemilikan yang PERMANEN. Tidak bisa mengandalkan activity_logs:
  // barisnya di-hard delete setelah ACTIVITY_LOG_RETENTION_DAYS (default 5 hari)
  // oleh sapuan di cleanup.service.js. "Siapa mengalihkan kepemilikan ke siapa"
  // adalah fakta tata kelola, bukan telemetri.
  ownershipTransferredAt DateTime? @map("ownership_transferred_at")
  previousOwnerUserId    String?   @map("previous_owner_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator      User                      @relation("SharedFinanceCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members      SharedFinanceMember[]
  invitations  SharedFinanceInvitation[]
  transactions SharedTransaction[]

  @@index([createdBy])
  @@map("shared_finances")
}

model SharedFinanceMember {
  id              String @id @default(uuid())
  sharedFinanceId String @map("shared_finance_id")
  userId          String @map("user_id")

  // String + CHECK, bukan enum Prisma: PRD §5/§6 memang meminta VARCHAR(20) +
  // CHECK, dan preseden `SavingsGoal.status` sudah memakai pola yang sama.
  // Nilai sahnya dijaga constraint di migration.sql.
  role   String @default("MEMBER") // OWNER | MEMBER
  status String @default("ACTIVE") // ACTIVE | LEFT | REMOVED

  // Baris ini TIDAK PERNAH dihapus, bahkan saat anggota dikeluarkan — statusnya
  // yang berubah. Itu yang membuat transaksi lamanya tetap bisa diatribusikan,
  // sekaligus jadi riwayat keanggotaan yang tahan sapuan activity_logs.
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sharedFinance SharedFinance @relation(fields: [sharedFinanceId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Invariant "tepat satu OWNER aktif" (PRD §7/§10) TIDAK ada di sini: Prisma
  // tidak bisa menyatakan unique index parsial. Index-nya ditulis tangan di
  // migration.sql sebagai uq_shared_finance_single_active_owner.
  @@unique([sharedFinanceId, userId], map: "uq_shared_finance_member")
  @@index([userId, status])
  @@map("shared_finance_members")
}

model SharedFinanceInvitation {
  id              String @id @default(uuid())
  sharedFinanceId String @map("shared_finance_id")
  code            String @unique

  createdBy String    @map("created_by")
  expiresAt DateTime? @map("expires_at")
  maxUses   Int?      @map("max_uses")
  useCount  Int       @default(0) @map("use_count")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  sharedFinance SharedFinance @relation(fields: [sharedFinanceId], references: [id], onDelete: Cascade)
  creator       User          @relation("SharedInvitationCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([sharedFinanceId])
  @@map("shared_finance_invitations")
}

model SharedTransaction {
  id              String @id @default(uuid())
  sharedFinanceId String @map("shared_finance_id")
  createdByUserId String @map("created_by_user_id")

  // Nullable dan HANYA boleh menunjuk kategori global (categories.user_id IS
  // NULL). Kategori pribadi milik satu anggota tidak akan pernah bisa diambil
  // anggota lain, jadi merujuknya berarti menampilkan nama yang tidak bisa
  // di-resolve sekaligus membocorkan taksonomi pribadi si pembuat.
  categoryId String? @map("category_id")

  // Didenormalisasi dari kategori supaya menghapus kategori tidak pernah
  // merusak tanda INCOME/EXPENSE baris yang sudah tercatat.
  type CategoryType

  amount      Decimal
  date        DateTime @db.Date
  description String?

  deletedAt DateTime? @map("deleted_at")

  // Ada di sini, tapi tidak ada di `Transaction`. Di tabel dengan banyak
  // penulis, urutan "siapa mencatat terakhir" harus stabil; memakai id uuid v4
  // sebagai tiebreak seperti transaksi pribadi berarti urutannya acak.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sharedFinance SharedFinance @relation(fields: [sharedFinanceId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("SharedTransactionCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  category      Category?     @relation(fields: [categoryId], references: [id])

  @@index([sharedFinanceId, date])
  @@index([sharedFinanceId, deletedAt])
  @@map("shared_transactions")
}
